# Copy to .env and fill in. Never commit .env or share it in chat.

PORT=3000

# mock = built-in simulator, live = real e-Solutions gateway
GATEWAY_MODE=mock
# Test gateway. Swap for the live URL when e-Solutions issues it.
GATEWAY_BASE_URL=https://test.esolutions.co.zw
GATEWAY_TXN_PATH=/billpayments/vend
GATEWAY_USERNAME=
GATEWAY_PASSWORD=
VENDOR_NUMBER=
TERMINAL_ID=BHADHALA01

# City of Harare merchant/product names (spec 5.11 says COH / COH_PREPAID)
COH_MERCHANT=COH
COH_PRODUCT=COH_PREPAID

# Resend timing from spec 4.2.2 (milliseconds)
CALL_TIMEOUT_MS=60000
FIRST_RESEND_MS=180000
RESEND_EVERY_MS=180000

# mock = auto-approve payments. Implement a real provider in src/payments.js
PAYMENTS_MODE=mock
